# =============================================================================
# Convexity Desk — environment variables
# Copy to .env.local (never commit it). Set the same values in Vercel →
# Project → Settings → Environment Variables for production.
# Variables without NEXT_PUBLIC_ are server-side only and never reach the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# SoSoValue — ETF flows, news, macro calendar (required for live risk factors)
# Docs: https://sosovalue-1.gitbook.io/sosovalue-api-doc  (header: x-soso-api-key)
# Quota: 20 requests/min, 100k/month — the app caches per source to stay inside it.
# Without a key, the affected factors use clearly labelled sample data.
# -----------------------------------------------------------------------------
SOSOVALUE_API_KEY=
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# -----------------------------------------------------------------------------
# Wallet scanning (server-side)
# Alchemy Portfolio API finds every token on Ethereum, Base, Arbitrum and Optimism.
# Without it, a curated list of well-known tokens is read over public RPCs.
# -----------------------------------------------------------------------------
ALCHEMY_API_KEY=

# Optional RPC overrides for the no-Alchemy path (public RPCs are used if empty)
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=

# -----------------------------------------------------------------------------
# SoDEX — prices, order books, volatility. Public endpoints, no key needed.
# Defaults to mainnet; override only to point at a different gateway.
# -----------------------------------------------------------------------------
SODEX_BASE_URL=

# -----------------------------------------------------------------------------
# Wallet connection (browser)
# Without a WalletConnect project ID only browser-extension wallets are offered.
# Free ID: https://cloud.reown.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Preferred chain for the wallet modal: 1 (Ethereum) or 11155111 (Sepolia)
NEXT_PUBLIC_CHAIN_ID=1

# Optional display name override
NEXT_PUBLIC_APP_NAME=Convexity Desk
